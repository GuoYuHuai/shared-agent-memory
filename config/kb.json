{
  "data_root": ".kb-data",
  "history_database": ".kb-data/history.sqlite",
  "checkpoint_directory": ".kb-data/checkpoints",
  "storage_profile": "lightweight",
  "retrieval": {"include_raw_history": false},
  "history_capture": {
    "enabled": false
  },
  "semantic_maintenance": {
    "enabled": false,
    "maximum_events_per_batch": 100,
    "maximum_characters_per_batch": 24000,
    "maximum_batches_per_run": 8,
    "maximum_model_calls": 8,
    "maximum_run_seconds": 600
  }
}
